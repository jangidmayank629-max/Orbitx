# Next.js App Contact Backend Configuration

# Primary Destination Email
RECIPIENT_EMAIL=orbitx.marketing@gmail.com

# OPTION 1: Resend API (Enterprise Email Delivery)
# Sign up at https://resend.com and obtain an API Key
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=OrbitX Contact <onboarding@resend.dev>

# OPTION 2: Nodemailer with Gmail SMTP
# Generate an App Password in your Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=orbitx.marketing@gmail.com
EMAIL_PASS=your_16_digit_app_password

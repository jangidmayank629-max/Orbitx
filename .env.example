# OrbitX Marketing Server Environment Configuration

# Server Port
PORT=5000

# Primary Destination Email
RECIPIENT_EMAIL=orbitx.marketing@gmail.com

# OPTION 1: Gmail SMTP / Nodemailer (Recommended for simple direct sending)
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=orbitx.marketing@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# OPTION 2: Resend API (Alternative enterprise email delivery)
# Sign up at https://resend.com and obtain an API Key
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=OrbitX Contact <onboarding@resend.dev>
